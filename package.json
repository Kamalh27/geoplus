{
  "name": "geoplus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:maplibre": "node scripts/sync-maplibre-worker.mjs",
    "sync:assets": "node scripts/copy-duckdb.mjs && node scripts/sync-maplibre-worker.mjs",
    "postinstall": "npm run sync:assets",
    "predev": "npm run sync:assets",
    "prebuild": "npm run sync:assets",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:tilesets": "node --import ./tests/node/alias-hooks.mjs --test --experimental-strip-types lib/geoplus/tilesets/*.test.ts",
    "test:geoplus": "node --import ./tests/node/alias-hooks.mjs --test --experimental-strip-types lib/geoplus/*.test.ts lib/geoplus/tilesets/*.test.ts"
  },
  "dependencies": {
    "@carbonplan/zarr-layer": "^0.5.2",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/extensions": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/maplibre": "^9.4.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev45.0",
    "@geomatico/maplibre-cog-protocol": "^0.10.0",
    "@loaders.gl/core": "^4.5.4",
    "@loaders.gl/gis": "^4.5.4",
    "@loaders.gl/mvt": "^4.5.4",
    "@loaders.gl/zarr": "^4.3.4",
    "@luma.gl/core": "~9.4.0",
    "@luma.gl/engine": "~9.4.0",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@marsidev/react-turnstile": "^1.5.1",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/turf": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-dsv": "^3.0.1",
    "echarts": "^6.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "mapbox-gl-draw-rectangle-mode": "^1.0.4",
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.3",
    "pmtiles": "^4.4.1",
    "radix-ui": "^1.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shpjs": "^6.2.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.5.0",
    "undici": "^8.12.3",
    "zarrita": "^0.7.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-dsv": "^3.0.7",
    "@types/geojson": "^7946.0.16",
    "@types/jszip": "^3.4.0",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1",
    "@loaders.gl/compression": {
      "fflate": "0.8.3"
    },
