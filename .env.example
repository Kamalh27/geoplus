# Next.js Environment Variables
# Copy this file to .env.local for local development

# Core Platform Frontend (Authentication provider)
NEXT_PUBLIC_CORE_URL=http://app.spadace.local:3000

# Core Platform Backend (API)
NEXT_PUBLIC_CORE_BACKEND_URL=http://localhost:8000

# GeoPlus Metadata
NEXT_PUBLIC_APP_NAME="SPADACE GeoPlus"
NEXT_PUBLIC_APP_URL="http://geoplus.spadace.local:3001"
NEXT_PUBLIC_PRODUCT_VERSION="1.0.0-beta"

# Cookie domain used when clearing auth cookies on logout. Must match what the core
# backend sets (e.g. ".spadace.local" in dev, ".spadace.com" in prod). Empty = host-only.
AUTH_COOKIE_DOMAIN=.spadace.local
