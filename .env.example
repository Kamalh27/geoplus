# Next.js Environment Variables
# Copy this file to .env.local for local development

# Core Platform Frontend (core web runs on 3010 in development; 3000 belongs to another project)
NEXT_PUBLIC_CORE_URL=http://localhost:3010

# Core Platform Backend (API, 8010 in development). Server-only: the browser calls core through this app's
# /api/core proxy (plan P3-b4), which adds the Account bearer token. Public dashboard files under
# /static/uploads/dashboards/ are still fetched from core by the browser; NEXT_PUBLIC_CORE_BACKEND_URL is that address.
CORE_BACKEND_URL=http://localhost:8010
NEXT_PUBLIC_CORE_BACKEND_URL=http://localhost:8010

# GeoPlus Metadata
NEXT_PUBLIC_APP_NAME="SPADACE GeoPlus"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_PRODUCT_VERSION="1.0.0-beta"

# --- Sign-in through Spadace Account (server-only; never NEXT_PUBLIC_) --------------------
# GeoPlus is its own web client (contracts/products.toml `geoplus-web-dev` / `geoplus-web`).
# Account API: 8050 (real dev Account) or http://127.0.0.1:8059 (core's `just fake-account`).
ACCOUNT_ISSUER=http://localhost:8050
ACCOUNT_WEB_CLIENT_ID=geoplus-web-dev
# Real dev Account: `uv run python -m app.modules.registry.secrets create web-client geoplus-web-dev`
# (in account/api). The fake Account's secret is fake-secret-geoplus-web-dev.
ACCOUNT_WEB_CLIENT_SECRET=
ACCOUNT_WEB_REDIRECT_URI=http://localhost:3001/auth/callback
ACCOUNT_WEB_SIGNED_OUT_URI=http://localhost:3001/auth/signed-out
# Seals the session cookie that holds the Account tokens (AES-256-GCM). 32 random bytes:
#   openssl rand -base64 32
# Rotation: move the old key into GEOPLUS_SESSION_PREVIOUS_KEYS (comma-separated) for 30 days.
GEOPLUS_SESSION_KEY=
GEOPLUS_SESSION_PREVIOUS_KEYS=
